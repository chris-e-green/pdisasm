CONST
  LIMIT = 8;
  GREETING = 'HELLO';
  LETTER_A = 'A';
  ENABLED = TRUE;
  RATIO = 3.125;
  DEFAULT_LIMIT = LIMIT;
  MASK = LIMIT + 1;

TYPE
  BYTEFILE = FILE OF BYTE;
  TEXTFILE = TEXT;
  COLORS = (RED, GREEN, BLUE);
  COLORSET = SET OF COLORS;

  NODEPTR = ^NODE;
  NODE = PACKED RECORD
    NEXT: NODEPTR;
    VALUE: INTEGER
  END;

  LEFTPTR = ^LEFTREC;
  RIGHTPTR = ^RIGHTREC;
  LEFTREC = RECORD
    RIGHT: RIGHTPTR
  END;
  RIGHTREC = RECORD
    LEFT: LEFTPTR
  END;

  COLORGRID = PACKED ARRAY[COLORS, 1..LIMIT] OF CHAR;
  CALLBACK = PROCEDURE(VAR VALUE: INTEGER; FLAG: BOOLEAN);
  MAPPER = FUNCTION(VALUE: INTEGER; BASE: INTEGER): INTEGER;
